@model SeyahatMVC25B.Models.TBLBLOGRESIMLER

@{
    ViewBag.Title = "Gorseller";
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2> <b>@ViewBag.gezi</b> RESİMLERİ</h2>

@using (Html.BeginForm("GorselKaydet", "AdminBloglar", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group">
        @Html.LabelFor(x => x.YAZI)
        @Html.TextBoxFor(x => x.YAZI, new { @class = "form-control", required = "required" })
    </div>
    <br />

    <div class="form-group row">
        @Html.LabelFor(x => x.RESIM)
        <input class="form-control col-md-6"
               id="resim"
               required
               type="file"
               onchange="$('.resim')[0].src = window.URL.createObjectURL(this.files[0])"
               name="RESIM" />

        <img class="resim" id="secilenresim" style="width:200px; height:180px;border:3px solid red;margin-left:20px;" />
    </div>

    <div class="form-group">
        @Html.LabelFor(x => x.BLOG)
        @Html.TextBoxFor(x => x.BLOG, new { @class = "form-control", required = "required" })
    </div>
    <br />

    <button class="btn btn-success">EKLE</button>
}

<br /><br />

<table class="table table-bordered">
    <tr>
        <td>ID</td>
        <td>RESIM</td>
        <td>YAZI</td>
        <td>BLOG</td>
        <td>GÜNCELLE</td>
        <td>SİL</td>
    </tr>

    @foreach (var x in ViewBag.grs)
    {
        <tr>
            <td>@x.ID</td>
            <td><img src="~/ResimlerGezi/@x.RESIM" style="width:100px;height:100px;" /></td>
            <td>@x.YAZI</td>
            <td>@x.TBLBLOG.BASLIK</td>
            <td>GÜNCELLE</td>
            <td>SİL</td>
        </tr>
    }

</table>
