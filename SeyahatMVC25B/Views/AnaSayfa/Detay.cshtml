@*bu blog için ortalama puan hesaplayalım*@

@*TOPLAM YILDIZ/YORUM SAYISI*@

@{
    decimal ort = 0;
    decimal toplam = 0;

    SeyahatMVC25B.Models.DbSeyahat25BEntities db = new SeyahatMVC25B.Models.DbSeyahat25BEntities();

    if (db.TBLYORUMLAR.Where(x => x.BLOGID == Model.BLOGID && x.DURUM == true).Count() != 0)
    {
        toplam = Convert.ToDecimal(db.TBLYORUMLAR.Where(x => x.BLOGID == Model.BLOGID && x.DURUM == true).Sum(x => x.YILDIZ));

        ort = Convert.ToDecimal(toplam / db.TBLYORUMLAR.Where(x => x.BLOGID == Model.BLOGID && x.DURUM == true).Count());
    }
}


<div class="breadcumb-area" style="background-image: url(../../tema/img/bg-img/breadcumb.jpg);">
    <div class="container h-100">
        <div class="row h-100 align-items-center">
            <div class="col-12">
                <div class="bradcumb-title text-center">
                    <h2>@Model.BASLIK</h2>

                    <span style="color:orange;font-size:25px;">(@ort)&nbsp;</span>
                    @if (ort % 1 == 0)
                    {
                        for (int i = 0; i < ort; i++)
                        {
                            <img src="~/ResimlerGezi/icons8-star-48.png" />
                        }
                        for (int i = 0; i < 5 - ort; i++)
                        {
                            <img src="~/ResimlerGezi/icons8-star-48 (1).png" />
                        }
                    }
                    else  //küsüratlı puan varsa
                    {
                        int sonuc = (int)ort;  //tam kısmını al
                        for (int i = 0; i < sonuc; i++)
                        {
                            <img src="~/ResimlerGezi/icons8-star-48.png" />
                        }

                        <img src="~/ResimlerGezi/icons8-star-half-48.png" />

                        for (int i = 0; i < 4 - ort; i++)
                        {
                            <img src="~/ResimlerGezi/icons8-star-48 (1).png" />
                        }
                    }

                </div>
            </div>
        </div>
    </div>
</div>


