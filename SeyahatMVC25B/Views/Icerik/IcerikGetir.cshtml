@model SeyahatMVC25B.Models.TBLICERIK

@{
    ViewBag.Title = "IcerikGetir";
    Layout = "~/Views/Shared/LayoutAdmin.cshtml";
}

<h2>IcerikGetir</h2>

<script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

<link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.js"></script>

<h2>Yeni Blog Ekle</h2>

@using (Html.BeginForm("Kaydet", "Icerik", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group">
        @Html.LabelFor(x => x.ID)
        @Html.TextBoxFor(x => x.ID, new { @class = "form-control", required = "required" })
    </div>
    <br />

    <div class="form-group">
        @Html.LabelFor(x => x.BASLIK)
        @Html.TextBoxFor(x => x.BASLIK, new { @class = "form-control", required = "required" })
    </div>
    <br />

    <div class="form-group row">
        @Html.LabelFor(x => x.DOSYA)
        <input class="form-control col-md-6"
               id="resim"
               @*required*@
               type="file"
               onchange="$('.resim')[0].src = window.URL.createObjectURL(this.files[0])"
               name="RESIM" />
    </div>

    <div class="form-group">
        TARİH
        <input class="form-control col-md-3" type="date" name="TARIH" value="@Convert.ToDateTime(Model.TARIH).ToString("yyyy-MM-dd")" />
    </div>

    <div class="form-group">
        AÇIKLAMA
        @Html.TextAreaFor(x => x.ICERIK, new { @class = "form-control", required = "required", id = "summernote" })
    </div>


    <button class="btn btn-outline-danger">KAYDET</button>

}

<script>
    $('#summernote').summernote({
        placeholder: 'İçeriğinizi burada hazırlayınız...',
        tabsize: 2,
        height: 200
    });
</script>

